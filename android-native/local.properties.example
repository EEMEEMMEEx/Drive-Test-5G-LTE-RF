## Copy to local.properties (git-ignored) and fill in real values.
## Never commit local.properties or any file containing these secrets.

sdk.dir=C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk

## Firebase / cloud sync (optional)
MAPS_API_KEY=
GEMINI_API_KEY=
FIREBASE_DB_URL=
FIREBASE_AUTH_TOKEN=
## Cloud upload endpoint of the Drive proxy Worker (worker/drive-upload.js).
## No Google credential belongs here: the Drive refresh token is a Worker secret (wrangler secret put GOOGLE_REFRESH_TOKEN).
CLOUD_UPLOAD_URL=

## Release signing (optional; without these the release build falls back to debug signing)
## Path to the keystore file, e.g. D:\\my-release-keystore
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=