<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_badge_rat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_5g"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="5G"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drive Test • RF Live Tracking"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session (2026-11-04 15:41)"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Cadence Chip -->
        <TextView
            android:id="@+id/tv_cadence_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_5g"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="Precise 1s"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Timer Chip -->
        <TextView
            android:id="@+id/tv_timer_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_grid_cell"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="02:28"
            android:textColor="#E2E8F0"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#1E293B" />

    <!-- 2. Hero Signal Metric & Quality -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_hero_rsrp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-78 dBm"
            android:textColor="#10B981"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_quality_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_5g"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="EXCELLENT"
            android:textColor="#34D399"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Serving Sector Text -->
    <TextView
        android:id="@+id/tv_serving_sector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Serving Sector: Cell #301 (n78+B1) • TAC 500 • AIS 5G"
        android:textColor="#38BDF8"
        android:textSize="10sp" />

    <!-- 3. Journey Route Tracking Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_grid_cell"
        android:orientation="vertical"
        android:padding="6dp">

        <ProgressBar
            android:id="@+id/pb_route_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/progress_track_custom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Start"
                android:textColor="#94A3B8"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/tv_route_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🚗 2.2 km/h • 147 pts"
                android:textColor="#34D399"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏁 Active"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. 2x3 Telemetry Matrix Grid -->
    <!-- Row 1: RSRQ, SINR, PCI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Cell 1: RSRQ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grid_cell"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSRQ"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_grid_rsrq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-11 dB"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cell 2: SINR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grid_cell"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SINR"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_grid_sinr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15.2 dB"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cell 3: PCI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grid_cell"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PCI"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_grid_pci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="384"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: SPEED, POINTS, SIM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <!-- Cell 4: SPEED -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grid_cell"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_grid_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.2 km/h"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cell 5: POINTS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grid_cell"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POINTS"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_grid_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="147"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cell 6: SIM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grid_cell"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_grid_sim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIS 5G"
                android:textColor="#34D399"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_stop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_stop"
            android:text="⏹️ Stop Recording"
            android:textAllCaps="false"
            android:textColor="#FCA5A5"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_new_session"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_session"
            android:text="🔄 New Session"
            android:textAllCaps="false"
            android:textColor="#6EE7B7"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
